#!/usr/bin/env ruby
# frozen_string_literal: true

require 'optparse'
require 'fileutils'

# Add lib to load path
$LOAD_PATH.unshift File.expand_path('../lib', __dir__)
require 'zbspec'

# Parse command line options
options = {
  config: 'spec/zbspec.yml',
  mod_dir: nil,
  spec_files: [],
  verbosity: 0,
  mode: :auto,  # :auto, :sp, :server, :client, :mp
  interactive: false,
  restart: false
}

OptionParser.new do |opts|
  opts.banner = 'Usage: zbspec [options] [spec_files...]'

  opts.on('-c', '--config PATH', 'Path to config file (default: spec/zbspec.yml)') do |path|
    options[:config] = path
  end

  opts.on('-m', '--mod-dir PATH', 'Path to mod directory') do |path|
    options[:mod_dir] = path
  end

  opts.on('-v', '--verbose', 'Increase verbosity (can be repeated: -vvv)') do
    options[:verbosity] += 1
  end

  opts.on('--sp', 'Run specs in singleplayer mode') do
    options[:mode] = :sp
  end

  opts.on('--server', 'Run specs on server only') do
    options[:mode] = :server
  end

  opts.on('--client', 'Run specs on client only') do
    options[:mode] = :client
  end

  opts.on('--mp', 'Run specs on both server and client') do
    options[:mode] = :mp
  end

  opts.on('--stop', 'Stop all running ZBSpec instances') do
    options[:mode] = :stop
  end

  opts.on('--restart', 'Restart instances before running specs') do
    options[:restart] = true
  end

  opts.on('-i', '--interactive', 'Interactive Lua console (can combine with --sp/--client/--server)') do
    options[:interactive] = true
  end

  opts.on('-h', '--help', 'Show this help') do
    puts opts
    puts "\nSpec folder structure:"
    puts "  spec/client/*_spec.lua  - Client-only specs (also run in SP)"
    puts "  spec/server/*_spec.lua  - Server-only specs"
    puts "  spec/shared/*_spec.lua  - Shared specs (run on both)"
    puts "  spec/*_spec.lua         - Root specs (treated as shared)"
    puts "\nModes:"
    puts "  (default)   Auto-detect: SP + MP if server specs exist"
    puts "  --sp        Singleplayer only"
    puts "  --mp        Multiplayer only (server + client)"
    puts "  --server    Dedicated server only"
    puts "  --client    MP client only (auto-starts server)"
    puts "  --stop      Stop all running ZBSpec instances"
    puts "  --restart   Stop instances then start fresh"
    puts "  -i          Interactive Lua console"
    puts "\nExamples:"
    puts "  zbspec                    # Auto-detect mode from spec folders"
    puts "  zbspec --mp               # Force MP mode"
    puts "  zbspec --sp               # Force SP mode"
    puts "  zbspec --stop             # Stop all running instances"
    puts "  zbspec --restart          # Restart instances before running specs"
    puts "  zbspec -i                 # Interactive console (all instances)"
    puts "  zbspec --client -i        # Interactive console (client only)"
    puts "  zbspec --server -i        # Interactive console (server only)"
    puts "  zbspec spec/my_spec.lua   # Run specific spec file"
    exit
  end

  opts.on('--version', 'Show version') do
    puts "ZBSpec v#{ZBSpec::VERSION}"
    exit
  end
end.parse!

# Remaining arguments are spec files
options[:spec_files] = ARGV unless ARGV.empty?

# Verify config file exists
unless File.exist?(options[:config])
  abort "❌ Config file not found: #{options[:config]}\n" \
        "   Create it or specify with --config PATH\n" \
        "   Example: spec/zbspec.yml"
end

# Load mod-specific test runner if available
test_runner_class = nil

def stop_instances(cache_dirs)
  found_any = false

  cache_dirs.each do |cache_dir|
    pid_file = File.join(cache_dir, 'pz.pid')
    next unless File.exist?(pid_file)

    found_any = true
    pid = File.read(pid_file).strip.to_i
    instance = File.basename(cache_dir)

    begin
      Process.kill(0, pid)  # Check if process exists
      puts "  Stopping #{instance} (PID: #{pid})..."
      Process.kill('TERM', pid)
      sleep 0.5
      # Force kill if still running
      begin
        Process.kill(0, pid)
        Process.kill('KILL', pid)
      rescue Errno::ESRCH
        # Already dead
      end
      puts "  ✓ Stopped #{instance}"
    rescue Errno::ESRCH
      puts "  ⚠️  #{instance} already stopped (stale PID file)"
    end

    File.delete(pid_file)

    # Also clean up port file
    port_file = File.join(cache_dir, 'zbLuaAPI.txt')
    File.delete(port_file) if File.exist?(port_file)
  end

  puts "  No running instances found" unless found_any
end

if options[:mod_dir]
  spec_paths = [
    File.join(options[:mod_dir], 'spec', 'framework', 'spec_runner.rb'),
    File.join(options[:mod_dir], 'spec', 'spec_runner.rb')
  ]
  
  mod_spec_file = spec_paths.find { |path| File.exist?(path) }
  
  if mod_spec_file
    puts "📦 Loading mod specs from: #{mod_spec_file}"
    require mod_spec_file
    
    test_runner_class = ObjectSpace.each_object(Class).find do |klass|
      klass < ZBSpec::TestRunner && klass != ZBSpec::TestRunner
    end
    
    puts "✓ Using custom spec runner: #{test_runner_class}" if test_runner_class
  end
end

# Handle interactive mode
if options[:interactive]
  if options[:restart]
    puts "🔄 Restarting instances..."
    stop_instances(%w[tmp/cache_sp tmp/cache_client tmp/cache_server])
    puts "✓ Done"
  end

  puts "🔧 Interactive Lua Console"
  puts "=" * 50
  
  # Determine which instances to connect to based on mode
  cache_dirs = case options[:mode]
               when :sp then ['tmp/cache_sp']
               when :server then ['tmp/cache_server']
               when :client then ['tmp/cache_client']
               when :mp then ['tmp/cache_server', 'tmp/cache_client']
               else %w[tmp/cache_sp tmp/cache_client tmp/cache_server]  # :auto - all
               end
  
  clients = {}
  
  # First pass: discover all responding instances
  cache_dirs.each do |cache_dir|
    port_file = File.join(cache_dir, 'zbLuaAPI.txt')
    next unless File.exist?(port_file)
    
    port = File.read(port_file).strip.to_i
    next if port <= 0
    
    instance = File.basename(cache_dir).sub('cache_', '')
    client = ZBSpec::APIClient.new(port: port)
    
    # Check if it's actually responding
    clients[instance] = { client: client, port: port } if client.ready?
  end
  
  # Calculate max instance name length for padding
  max_len = clients.keys.map(&:length).max || 0
  
  # Print connected instances with padding
  clients.each do |instance, data|
    puts "  ✓ Connected to #{instance.ljust(max_len)} (port #{data[:port]})"
  end
  
  # Replace hash values with just the clients
  clients.transform_values! { |data| data[:client] }
  
  # Cancel any pending async jobs from previous test runs
  clients.each do |instance, client|
    begin
      cancelled = client.execute('return ZBSpec.cancelAllJobs()')
      puts "  ⚠️  Cancelled #{cancelled} pending jobs on #{instance}" if cancelled && cancelled > 0
    rescue
      # Ignore - ZBSpec might not be loaded
    end
  end
  
  if clients.empty?
    puts "\n❌ No running instances found. Start a game first with:"
    puts "   zbspec --sp    # Singleplayer"
    puts "   zbspec --mp    # Multiplayer"
    exit 1
  end
  
  puts "\nType Lua code to execute on all instances."
  puts "Type 'exit' or press Ctrl+D/Ctrl+C to quit.\n\n"
  
  require 'readline'
  
  # History file
  history_file = File.expand_path('~/.zbspec_history')
  
  # Load history from file
  if File.exist?(history_file)
    File.readlines(history_file).each do |line|
      Readline::HISTORY.push(line.chomp)
    end
  end
  
  # Save history on exit
  at_exit do
    File.open(history_file, 'w') do |f|
      Readline::HISTORY.to_a.last(1000).each { |line| f.puts(line) }
    end
  end
  
  trap('INT') { puts "\nBye!"; exit 0 }
  
  while (line = Readline.readline('lua> ', true))
    line = line.strip
    break if line == 'exit' || line == 'quit'
    next if line.empty?
    
    # Don't add duplicate consecutive entries to history
    if Readline::HISTORY.length > 1 && Readline::HISTORY[-2] == line
      Readline::HISTORY.pop
    end
    
    # Add implicit return if line has no semicolon and no return
    lua_code = if !line.include?(';') && !line.match?(/\breturn\b/)
                 "return #{line}"
               else
                 line
               end
    
    clients.each do |instance, client|
      begin
        result = client.execute(lua_code)
        if clients.size > 1
          puts "[#{instance.ljust(max_len)}] #{result.inspect}"
        else
          puts result.inspect
        end
      rescue ZBSpec::APIClient::LuaError => e
        prefix = clients.size > 1 ? "[#{instance.ljust(max_len)}] " : ""
        puts "#{prefix}Error: #{e.error_message}"
        puts "#{prefix}  File: #{e.file}:#{e.line}" if e.file
        puts "#{prefix}  Test: #{e.test_name}" if e.test_name
        if options[:verbosity] >= 1 && e.lua_return
          puts "#{prefix}  Raw:"
          e.lua_return['kahluaErrors']&.each do |err|
            err.each_line { |l| puts "#{prefix}    #{l.rstrip}" }
          end
        end
      rescue => e
        puts "[#{instance.ljust(max_len)}] Error: #{e.class}: #{e.message}"
      end
    end
  end
  
  puts "Bye!"
  exit 0
end

# Discover specs and determine mode
discovery = ZBSpec::SpecDiscovery.new

if options[:spec_files].any?
  puts "📋 Running specified spec files: #{options[:spec_files].join(', ')}"
else
  puts "📋 Discovered specs: #{discovery.summary}"
end

# Auto-detect mode if not specified
if options[:mode] == :auto
  options[:mode] = discovery.recommended_mode
  mode_reason = case options[:mode]
                when :both then "running SP + MP"
                when :mp then "server + client specs found"
                when :server then "only server specs found"
                else "no server specs found"
                end
  puts "🔍 Auto-detected mode: #{options[:mode]} (#{mode_reason})"
end

if options[:restart]
  puts "🔄 Restarting instances..."
  stop_instances(%w[tmp/cache_sp tmp/cache_client tmp/cache_server])
  puts "✓ Done"
end

# Run the appropriate harness
FileUtils.mkdir_p('logs')

case options[:mode]
when :both
  # Run SP first, then MP
  puts "\n" + "=" * 50
  puts "🎮 Phase 1: Singleplayer mode"
  puts "=" * 50
  spec_files = options[:spec_files].empty? ? discovery.specs_for(:sp) : options[:spec_files]
  sp_harness = ZBSpec::Harness.new(
    config_path: options[:config],
    test_runner_class: test_runner_class,
    spec_files: spec_files.empty? ? nil : spec_files,
    verbosity: options[:verbosity]
  )
  sp_harness.run_without_exit
  
  puts "\n" + "=" * 50
  puts "🎮 Phase 2: Multiplayer mode"
  puts "=" * 50
  mp_harness = ZBSpec::MPHarness.new(
    config_path: options[:config],
    spec_files: options[:spec_files].empty? ? nil : options[:spec_files],
    verbosity: options[:verbosity]
  )
  mp_harness.run
when :mp
  puts "\n🎮 Multiplayer mode: running specs on server and client"
  harness = ZBSpec::MPHarness.new(
    config_path: options[:config],
    spec_files: options[:spec_files].empty? ? nil : options[:spec_files],
    verbosity: options[:verbosity]
  )
when :server
  puts "\n🖥️  Server mode: running specs on dedicated server"
  spec_files = options[:spec_files].empty? ? discovery.specs_for(:server) : options[:spec_files]
  harness = ZBSpec::Harness.new(
    config_path: options[:config],
    test_runner_class: test_runner_class,
    spec_files: spec_files.empty? ? nil : spec_files,
    verbosity: options[:verbosity],
    config_overrides: { 'server_mode' => true }
  )
when :client
  puts "\n💻 Client mode: running specs on MP client (auto-starting server)"
  spec_files = options[:spec_files].empty? ? discovery.specs_for(:client) : options[:spec_files]
  harness = ZBSpec::MPHarness.new(
    config_path: options[:config],
    spec_files: spec_files.empty? ? nil : spec_files,
    verbosity: options[:verbosity],
    client_only: true
  )
when :stop
  puts "🛑 Stopping all ZBSpec instances..."
  stop_instances(%w[tmp/cache_sp tmp/cache_client tmp/cache_server])
  puts "✓ Done"
  exit 0
else
  # Default: singleplayer
  puts "\n🎮 Singleplayer mode"
  spec_files = options[:spec_files].empty? ? discovery.specs_for(:sp) : options[:spec_files]
  harness = ZBSpec::Harness.new(
    config_path: options[:config],
    test_runner_class: test_runner_class,
    spec_files: spec_files.empty? ? nil : spec_files,
    verbosity: options[:verbosity]
  )
end

harness.run
